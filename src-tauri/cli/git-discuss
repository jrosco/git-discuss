#!/bin/sh
SOURCE=$0
while [ -L "$SOURCE" ]; do
  SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  LINK=$(readlink "$SOURCE")
  case "$LINK" in
    /*) SOURCE=$LINK ;;
    *) SOURCE=$SOURCE_DIR/$LINK ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
RESOURCE_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
exec "$RESOURCE_DIR/runtime/node" "$RESOURCE_DIR/app/dist/cli.js" "$@"
