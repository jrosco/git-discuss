{
  "name": "git-discuss",
  "version": "0.6.0",
  "description": "Local-first Git-backed code reviews and commit discussions",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrosco/git-discuss.git"
  },
  "homepage": "https://github.com/jrosco/git-discuss#readme",
  "bugs": {
    "url": "https://github.com/jrosco/git-discuss/issues"
  },
  "keywords": [
    "git",
    "code-review",
    "cli",
    "developer-tools"
  ],
  "bin": {
    "git-discuss": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/core/",
    "dist/git/",
    "dist/server/",
    "dist/web/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/build-tray-icon.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node --test tests/built.smoke.mjs",
    "cli": "tsx src/cli.ts",
    "start": "node dist/cli.js serve",
    "desktop:prepare": "npm run build && tauri icon assets/icon.svg --output src-tauri/icons && node scripts/prepare-tauri-resources.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:pack": "npm run desktop:prepare && tauri build --no-bundle",
    "desktop:dist": "npm run desktop:prepare && tauri build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "commander": "^14.0.0",
    "fastify": "^5.6.0",
    "open": "^10.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tauri-apps/cli": "^2.8.4",
    "sharp": "^0.35.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
