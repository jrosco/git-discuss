{
  "name": "git-review-app",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first Git-backed review conversations",
  "type": "module",
  "bin": {
    "git-discuss": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/build-tray-icon.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node --test tests/built.smoke.mjs",
    "cli": "tsx src/cli.ts",
    "start": "node dist/cli.js serve",
    "desktop:prepare": "npm run build && tauri icon assets/icon.svg --output src-tauri/icons && node scripts/prepare-tauri-resources.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:pack": "npm run desktop:prepare && tauri build --no-bundle",
    "desktop:dist": "npm run desktop:prepare && tauri build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "commander": "^14.0.0",
    "fastify": "^5.6.0",
    "open": "^11.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tauri-apps/cli": "^2.8.4",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
